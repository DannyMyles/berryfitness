# Berry Fitness for Health — frontend environment. Copy to .env.local.
# Never commit real secrets; .env.local is git-ignored.

NEXT_PUBLIC_APP_NAME=Berry Fitness for Health
# Public URL of this site (used for metadata, sitemap and links).
NEXT_PUBLIC_APP_URL=http://localhost:3002

# NextAuth (customer and admin sign-in). Generate with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3002
NEXTAUTH_SECRET=change-me

# Display currency. Must match the backend app setting `currency` (USD).
NEXT_PUBLIC_CURRENCY=USD

# Contact details, social links, hours and page copy are managed in
# Admin → Settings (stored in the database). This is only a fallback used
# if the API is unreachable.
NEXT_PUBLIC_WHATSAPP=254727625970

# Berry API (../berry_api). The browser only calls
# this site's own /api/* and /uploads/*; proxy.ts forwards them to BACKEND_URL
# tagged X-App-Key=NEXT_PUBLIC_APP_KEY.
BACKEND_URL=http://localhost:4001
NEXT_PUBLIC_APP_KEY=berry
# Optional fallback for admin screens (backend: npm run app -- rotate-key --key berry).
# COMMERCE_ADMIN_KEY=
